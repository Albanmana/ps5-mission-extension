# Configuration du serveur local. « npm run setup » copie ce fichier en .env.
# Ne partagez jamais .env et ne le commitez pas.
# Format : NOM=valeur, sans espace avant le nom ni commentaire en fin de ligne.
# Redémarrez le serveur après toute modification.

# Obligatoire : clé OpenRouter (classification des annonces et réponses).
OPENROUTER_API_KEY=

# Obligatoire pour l'extension : chrome-extension://<ID affiché par Chrome>
EXTENSION_ORIGIN=

# Facultatif : e-mails de reprise via Resend. Vide = pas d'e-mail.
RESEND_API_KEY=
# Expéditeur. Vide = PS5 Mission <onboarding@resend.dev>
RESEND_FROM_EMAIL=
# Destinataire des reprises de la page « copilote » uniquement. L'extension
# n'utilise que le champ e-mail de l'onglet Réglages (vide = pas d'e-mail).
HANDOFF_EMAIL=

# Facultatif : base PostgreSQL. Vide = base Supabase locale (port 54322).
SUPABASE_DB_URL=
